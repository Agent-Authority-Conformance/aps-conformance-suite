    },
    {
      "id": "scope-dropped-entirely",
      "properties": [
        "P1",
        "P2"
      ],
      "note": "T2 carries no scope member at all. The empty set is a subset of anything, so the vector is valid and every scope request denies.",
      "vector_valid": true,
      "subject_token_claims": {
        "sub": "user:hank",
        "scope": "mcp:tools read write",
        "aud": "mcp-gateway",
        "upstream_claims": {
          "groups": [
            "platform",
