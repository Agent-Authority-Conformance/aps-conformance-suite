          ],
          "department": "infrastructure"
        }
      },
      "exchanged_token_claims": {
        "sub": "user:hank",
        "aud": "mcp-gateway",
        "act": {
          "sub": "svc:exchange"
        },
        "upstream_claims": {}
      },
      "requests": [
        {
          "id": "needs-read",
          "action": "read",
          "resource": "repo:docs",
          "requires": {
            "scope": "read"
          },
          "audience": "mcp-gateway"
        }
      ],
      "expected": [
        {
          "request": "needs-read",
          "against_t2": "deny",
          "against_t1": "permit",
          "deny_reason": "scope_not_granted"
        }
      ]
    }
  ]
}
