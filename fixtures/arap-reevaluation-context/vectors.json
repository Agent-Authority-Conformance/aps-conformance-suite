  "negative_controls": {
    "present_only_pdp": {
      "applies_to": "the PDP outcome of every case that sends a request",
      "declared_to_fail": [
        "R2",
        "R5b",
        "R7"
      ],
      "defect": "Skips a bound member that is absent from the request instead of comparing it, which 982 rules out."
    },
    "approval_tampering_peps": {
      "applies_to": "every ordinary-rules case that sends a request, rerun with each of four PEPs: drop-approval, changed-approval-id, changed-approval-timestamp, in-place-approval-rewrite",
      "declared_to_fail": [
        "R1",
        "R3",
        "R4",
        "R6",
        "R7"
      ],
      "defect": "Leaves the approval out, changes its id, rewrites approved_until in a copy, or rewrites approved_at in place on the object it was handed, which 822 rules out. The runner compares the emitted approval with its own pristine copy and passes the emitted one to the PDP."
    },
    "alternating_pep": {
      "applies_to": "every ordinary-rules case that sends a request, with a fresh alternating PEP per case",
      "declared_to_fail": [
        "R1",
        "R3",
        "R4",
        "R6",
        "R7"
      ],
      "defect": "Its first request carries a member no ordinary rule produces and its later requests are clean. The member is unbound, so the PDP outcome does not change. The runner calls the PEP once and runs the member-set test on that emitted request."
    },
    "approval_only_pep": {
      "applies_to": "every ordinary-rules case, rerun with the approval-only PEP",
      "declared_to_fail": [
        "R1",
        "R3",
        "R4",
        "R5",
        "R6",
        "R7"
      ],
      "defect": "Builds re-evaluation Context from the approval and time only, which 824 rules out. In R3 and R7 the PDP outcome is the same either way, and the member-set comparison still catches it."
    }
  }
