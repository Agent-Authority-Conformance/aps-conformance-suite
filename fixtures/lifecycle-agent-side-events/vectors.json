      "document": "AUTHORITY-LIFECYCLE.md",
      "version": "0.1.2-draft",
      "section": "Lifecycle concepts are separate > Verification and evidence",
      "concept": "Notice",
      "quote": "Notice. That a particular party or enforcement point learned of a transition at a particular time. Recording a transition and observing it are different events.",
      "status_in_that_document": "proposed",
      "status_quote": "The grouping and every other entry are **proposed**, added in 0.1.1-draft or 0.1.2-draft. No public case tests them yet."
