{
  "profile": "aps-lifecycle-agent-side-events-v0",
  "status": "candidate_against_proposed",
  "description": "Events on the agent side of an unchanged grant: a self-made copy and a new instance carrying transferred memory present the same authority material, a still-fresh credential is presented twice and a replay record is lost, the executor a grant names is retired on a published schedule, a revocation notice takes effect part way through the window, and a capability appears in the runtime that the principal never consented to. Twenty presentations against four one-hop grants that are valid under every lifecycle rule at every instant evaluated. Every vector is candidate against proposed text.",
  "evaluation": "Each presentation is an independent evaluation against a fresh boundary. The consumed-credential set and the lost-record instant are inputs to each presentation, not state carried between them, so presentation order does not matter.",
  "verdict_vocabulary": [
    "valid",
    "invalid",
    "not_established",
    "restricted"
  ],
  "case_source": {
    "repository": "https://github.com/aeoess/agent-authority-lifecycle",
