      "version": "0.1.2-draft",
      "section": "Lifecycle concepts are separate > Parties and standing",
      "concept": "Agent identity",
      "quote": "Agent identity. Says which agent is acting. Identity continuity does not establish authority continuity.",
      "status_in_that_document": "proposed",
      "status_quote": "The grouping and every other entry are **proposed**, added in 0.1.1-draft or 0.1.2-draft. No public case tests them yet."
    },
    "presented-credential-or-session": {
      "repository": "https://github.com/aeoess/agent-authority-lifecycle",
      "commit": "7796e22fb80480d0336ff0967a862c84284c15e4",
      "document": "AUTHORITY-LIFECYCLE.md",
      "version": "0.1.2-draft",
      "section": "Lifecycle concepts are separate > Authority and dependencies",
      "concept": "Presented credential or session",
      "quote": "Presented credential or session. A session or derived token used to exercise authority in a particular request. Ending a grant does not necessarily invalidate every session or derived token already issued, and ending a session does not by itself end the grant.",
      "status_in_that_document": "proposed",
      "status_quote": "The grouping and every other entry are **proposed**, added in 0.1.1-draft or 0.1.2-draft. No public case tests them yet."
    },
    "action-or-capability-binding": {
      "repository": "https://github.com/aeoess/agent-authority-lifecycle",
      "commit": "7796e22fb80480d0336ff0967a862c84284c15e4",
      "document": "AUTHORITY-LIFECYCLE.md",
      "version": "0.1.2-draft",
      "section": "Lifecycle concepts are separate > Authority and dependencies",
      "concept": "Action or capability binding",
      "quote": "Action or capability binding. Which operation, implementation or schema a grant refers to, where that distinction matters. A tool can keep its name while what it does changes, which widens effective authority without any change to the grant.",
      "status_in_that_document": "proposed",
      "status_quote": "The grouping and every other entry are **proposed**, added in 0.1.1-draft or 0.1.2-draft. No public case tests them yet."
    },
    "approval": {
      "repository": "https://github.com/aeoess/agent-authority-lifecycle",
      "commit": "7796e22fb80480d0336ff0967a862c84284c15e4",
      "document": "AUTHORITY-LIFECYCLE.md",
      "version": "0.1.2-draft",
      "section": "Lifecycle concepts are separate > Decisions and effects",
      "concept": "Approval",
      "quote": "Approval. A principal or approver allows a proposed action. It is an input to authorization, with its own scope, expiry and use count, and it can be withdrawn before dispatch.",
      "status_in_that_document": "proposed",
      "status_quote": "The grouping and every other entry are **proposed**, added in 0.1.1-draft or 0.1.2-draft. No public case tests them yet."
    },
