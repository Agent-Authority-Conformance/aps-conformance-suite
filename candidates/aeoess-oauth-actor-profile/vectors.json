{
  "label": "candidate against draft-mcguinness-oauth-actor-profile at d76465c (the -01 text) and against d76465c with PR #32 applied; author-produced; not a conformance result",
  "identifiers": "all example.com values are illustrative",
  "cases": [
    {
      "id": "AC-01",
      "note": "unique per-agent registration is the basis; agent scope requested",
      "request": {
        "grant_type": "authorization_code",
        "client_id": "agent-a",
        "requested_scope": "openid agent calendar.read"
      },
      "as_state": {
        "delegation_basis": {
          "kind": "registration",
          "registration_unique": true,
          "actor": {
            "iss": "https://as.example.com",
            "sub": "agent-a"
          },
          "covers_sub": "user-1",
          "only_basis": true,
          "actor_mapping": "registration records no key; no trusted mapping from agent-a to any thumbprint"
        }
      },
      "outcome": {
        "issued": {
          "iss": "https://as.example.com",
          "sub": "user-1",
          "client_id": "agent-a",
          "act": {
            "iss": "https://as.example.com",
            "sub": "agent-a",
            "sub_profile": "ai_agent"
          }
        }
      },
      "expect": {
        "-01": "conformant",
        "-01+pr32": "conformant"
      },
      "expect_rule": {
        "-01": "R-5.2-basis",
        "-01+pr32": "R-5.2-basis"
      }
    },
